# Optional giscus comments.
# Fill these values from https://giscus.app, then choose one mode:
# PUBLIC_GISCUS_MODE=off
# PUBLIC_GISCUS_MODE=giscus
# PUBLIC_GISCUS_MODE=giscus-custom
PUBLIC_GISCUS_MODE=off
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_GISCUS_REACTIONS_ENABLED=0

# Optional Cloudflare Web Analytics site token.
# In Cloudflare, add blog.estebanmurcia.dev as a Web Analytics site and copy
# only the token value from its JavaScript snippet.
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Optional: only needed by `pnpm syndicate` when sending a post to DEV Community.
# Create a key at https://dev.to/settings/extensions and keep the real value in .env.local.
DEVTO_API_KEY=
