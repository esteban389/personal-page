---
import type { ImageMetadata } from 'astro';
import config from '../../astro-theme-config';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { getLocale, getLocaleConfig, otherLocale, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  ogImageUrl?: string;
  type?: 'website' | 'article';
  pubDate?: string;
  updatedDate?: string;
  robots?: string;
  canonicalUrl?: string;
  pageUrl?: string;
  locale?: Locale;
  alternateUrl?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  image,
  ogImageUrl,
  type,
  pubDate,
  updatedDate,
  robots,
  canonicalUrl,
  pageUrl,
  locale,
  alternateUrl,
  bodyClass,
} = Astro.props;
const activeLocale = getLocale(locale);
const localizedSite = getLocaleConfig(activeLocale);
const alternateLocale = otherLocale(activeLocale);
const alternateLinks = alternateUrl
  ? [
      { lang: activeLocale, href: Astro.url.pathname },
      { lang: alternateLocale, href: alternateUrl },
    ]
  : [];
---

<!doctype html>
<html
  lang={localizedSite.lang}
  data-smooth-scroll={config.behavior.smoothScroll ? 'true' : 'false'}
>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      ogImageUrl={ogImageUrl}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      robots={robots}
      canonicalUrl={canonicalUrl}
      pageUrl={pageUrl}
      locale={localizedSite.locale}
      lang={activeLocale}
      siteTitle={localizedSite.title}
      siteDescription={localizedSite.description}
      alternateLinks={alternateLinks}
    />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Header locale={activeLocale} alternateUrl={alternateUrl} />
    <SearchPalette locale={activeLocale} />
    <slot />
    <Footer locale={activeLocale} />
    <script>
      import { onReady } from '../scripts/mount';
      import { mountImageLoadingStates } from '../scripts/image-loading';
      import { mountSkipLinkFocus } from '../scripts/skip-link';

      onReady(mountSkipLinkFocus);
      onReady(mountImageLoadingStates);
    </script>
  </body>
</html>
