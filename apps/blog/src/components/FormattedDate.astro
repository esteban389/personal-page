---
import { getLocaleConfig, type Locale } from '../i18n';

interface Props {
  date: Date;
  class?: string;
  locale?: Locale;
}

const { date, class: className, locale = 'en' } = Astro.props;
---

<time class={className} datetime={date.toISOString()}>
  {
    date.toLocaleDateString(getLocaleConfig(locale).dateLocale, {
      year: 'numeric',
      month: 'short',
      day: '2-digit',
    })
  }
</time>
