---
import '../styles/pages/about.css';
import config from '../../astro-theme-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedPath, otherLocale, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const about = config.about.locales[locale];
const alternateUrl = localizedPath(otherLocale(locale), '/about/');
const profileImageUrl = config.about.profileImage.trim();
const hasProfileImage = profileImageUrl.length > 0;
const profileName = config.about.name || config.site.author;
const profileRole = about.role;
const profileLocation = about.location;
const profileFocus = about.focus;
const profileLead = about.lead;
const [headlineFirst, headlineSecond] = about.headline;
const statementLabel = about.statementLabel;
const statementTitle = about.statementTitle;
const statement = about.statement;
const careerLabel = about.careerLabel;
const careerItems = about.career;
const focusItems = about.interests;
const interestsLabel = about.interestsLabel;
const interestsHeading = about.interestsHeading;
const profileLinks = [
  {
    label: 'GitHub',
    href: config.social.github,
  },
  {
    label: locale === 'es' ? 'Sitio web' : 'Website',
    href: config.social.website,
  },
  {
    label: 'LinkedIn',
    href: config.social.linkedin,
  },
  {
    label: locale === 'es' ? 'Correo' : 'Email',
    href: config.social.email ? `mailto:${config.social.email}` : '',
  },
].filter((link) => link.href);
---

<BaseLayout
  title={about.pageTitle}
  description={profileLead}
  locale={locale}
  alternateUrl={alternateUrl}
>
  <main id="main-content" class="about-main">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-intro">
        <h1 id="about-title" class="about-title">
          {headlineFirst}<br />
          {headlineSecond}
        </h1>
        <p class="about-lead">
          {profileLead}
        </p>
      </div>

      <aside
        class:list={['profile-panel', !hasProfileImage && 'profile-panel--text']}
        aria-label={about.profileAriaLabel}
      >
        {
          hasProfileImage && (
            <figure class="profile-media">
              <img
                src={profileImageUrl}
                width="720"
                height="720"
                alt={about.profileAlt}
                loading="eager"
                referrerpolicy="no-referrer"
              />
            </figure>
          )
        }
        <div class="profile-summary">
          <p class="profile-name">{profileName}</p>
          <p class="profile-role">{profileRole}</p>
        </div>
        <dl class="profile-meta">
          <div>
            <dt>{about.metaLabels.location}</dt>
            <dd>{profileLocation}</dd>
          </div>
          <div>
            <dt>{about.metaLabels.focus}</dt>
            <dd>{profileFocus}</dd>
          </div>
          {
            profileLinks.length > 0 && (
              <div>
                <dt>{about.metaLabels.links}</dt>
                <dd class="profile-links">
                  {profileLinks.map((link) => (
                    <a
                      href={link.href}
                      target={link.href.startsWith('mailto:') ? undefined : '_blank'}
                      rel={link.href.startsWith('mailto:') ? undefined : 'noopener'}
                    >
                      {link.label}
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </aside>
    </section>

    <section class="about-section about-statement" aria-labelledby="about-statement">
      <p class="section-label">{statementLabel}</p>
      <div>
        <h2 id="about-statement" class="section-heading">
          {statementTitle}
        </h2>
        <p>{statement}</p>
      </div>
    </section>

    <section class="about-section" aria-label={careerLabel}>
      <p class="section-label">{careerLabel}</p>
      <div class="career-list">
        {
          careerItems.map((item) => (
            <article class="career-item">
              <time>{item.period}</time>
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="about-section" aria-labelledby="about-focus">
      <p class="section-label">{interestsLabel}</p>
      <div>
        <h2 id="about-focus" class="section-heading">{interestsHeading}</h2>
        <ul class="focus-list">
          {focusItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
