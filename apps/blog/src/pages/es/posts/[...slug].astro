---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import readingTimeLib from 'reading-time';
import { localizedPath, localizedPostSlug } from '../../../i18n';
import PostLayout from '../../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const collection = await getCollection('posts');
  const allPosts = collection
    .filter((post) => !post.data.draft && post.data.lang === 'es')
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return allPosts.map((post) => {
    const translation = post.data.translationKey
      ? collection.find(
          (candidate) =>
            !candidate.data.draft &&
            candidate.data.lang === 'en' &&
            candidate.data.translationKey === post.data.translationKey
        )
      : undefined;

    return {
      params: { slug: localizedPostSlug(post.id, 'es') },
      props: {
        post,
        alternateUrl: translation
          ? localizedPath('en', `/posts/${localizedPostSlug(translation.id, 'en')}/`)
          : undefined,
        relatedPosts: allPosts
          .filter((candidate) => candidate.id !== post.id)
          .sort((a, b) => {
            const sameCategoryA = a.data.category === post.data.category ? 1 : 0;
            const sameCategoryB = b.data.category === post.data.category ? 1 : 0;
            if (sameCategoryA !== sameCategoryB) return sameCategoryB - sameCategoryA;
            return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
          })
          .slice(0, 3),
      },
    };
  });
}

interface Props {
  post: CollectionEntry<'posts'>;
  relatedPosts: CollectionEntry<'posts'>[];
  alternateUrl?: string;
}

const { post, relatedPosts, alternateUrl } = Astro.props;
const { Content } = await render(post);
const readingTime = Math.max(1, Math.round(readingTimeLib(post.body ?? '').minutes));
---

<PostLayout
  {...post.data}
  readingTime={readingTime}
  focusEffect={post.data.focusEffect}
  relatedPosts={relatedPosts}
  alternateUrl={alternateUrl}
>
  <Content />
</PostLayout>
