---
import '../../styles/pages/posts-index.css';
import { getCollection } from 'astro:content';
import PostFeed from '../../components/PostFeed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUiText } from '../../ui';
import { getLocaleConfig, localizedPath, otherLocale, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const tr = getUiText(locale);
const site = getLocaleConfig(locale);
const alternateUrl = localizedPath(otherLocale(locale), '/posts/');

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft && p.data.lang === locale)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={tr.postsTitle}
  description={site.description}
  locale={locale}
  alternateUrl={alternateUrl}
>
  <main id="main-content" class="posts-main">
    <div class="posts-header">
      <div>
        <p class="posts-label eyebrow-accent">{tr.postsEyebrow}</p>
        <h1 class="posts-title">{tr.postsTitle}</h1>
      </div>
    </div>

    <PostFeed posts={posts} basePath="/posts" initialVisible={8} locale={locale} />
  </main>
</BaseLayout>
